---
// 功能：必备柜——跨场景挑出的高频卡钉在顶部。无论在哪个场景这些都要会。
// 输入：cards（已按 is_essential + tier 选好的 10 张）
// 输出：一个带标题的 <section id="essential-bar"> + 卡片网格
// 依赖：types, Card
// 在项目中的作用：index.astro 首屏的第一块内容，场景跳转条的 ⭐ 锚点目标

import type { Card as CardType } from '../lib/types';
import Card from './Card.astro';

interface Props {
  cards: CardType[];
}

const { cards } = Astro.props;
---

<section id="essential-bar" class="mb-12 scroll-mt-20">
  <header class="mb-4 flex flex-col gap-1">
    <div class="flex items-baseline gap-3 flex-wrap">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-accent">
        ⭐ 必备卡
      </h2>
      <span class="text-xs font-sans text-muted">{cards.length} 张 · 跨场景高频</span>
    </div>
    <p class="text-sm text-ink-soft max-w-2xl">
      从各场景挑出的超高频。无论你在哪个场景，这些都要会。
    </p>
    <div class="h-[2px] rounded-full" style="background: var(--accent-soft);"></div>
  </header>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {cards.map((c) => <Card card={c} />)}
  </div>
</section>
